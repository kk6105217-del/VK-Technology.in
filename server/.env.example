# ========================================================
# VK TECHNOLOGY SERVER - PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.vktechnology.shop
API_BASE_URL=https://www.vktechnology.shop/api
CORS_ORIGINS=https://vktechnology.shop,https://www.vktechnology.shop,http://localhost:5173

# MongoDB Atlas Primary Connection String
MONGODB_URI=mongodb+srv://admin:YourSecurePassword@cluster0.mongodb.net/vktechnology?retryWrites=true&w=majority

# JWT Token Pair Configuration
JWT_SECRET=vk_technology_access_jwt_super_secret_production_key_2026_xyz
JWT_ACCESS_SECRET=vk_technology_access_jwt_super_secret_production_key_2026_xyz
JWT_REFRESH_SECRET=vk_technology_refresh_rotation_jwt_super_secret_key_2026_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Account
ADMIN_EMAIL=admin@vktechnology.shop
ADMIN_INITIAL_PASSWORD=Admin@VK2026!
OWNER_EMAIL=karthik.suroju@gmail.com
OWNER_PHONE=+918555997052

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ========================================================
# AUTOMATIC EMAIL & WHATSAPP ORDER NOTIFICATION SYSTEM
# ========================================================

# Store Owner Notification Recipient Details
STORE_OWNER_EMAIL=karthik.suroju@gmail.com
WHATSAPP_OWNER_NUMBER=918555997052

# 1. Email Integration (Nodemailer SMTP)
# Works with Gmail (smtp.gmail.com), Zoho, Hostinger, Brevo, AWS SES, or SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=karthik.suroju@gmail.com
SMTP_PASS=your_16_digit_app_password_without_spaces
EMAIL_FROM="VK Technology <karthik.suroju@gmail.com>"

# 2. Official Meta WhatsApp Business Cloud API
# Retrieved from Meta for Developers -> My Apps -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_system_user_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OWNER_TEMPLATE=vk_new_order_owner
WHATSAPP_CUSTOMER_TEMPLATE=vk_order_confirmation
