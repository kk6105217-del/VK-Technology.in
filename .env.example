# ========================================================
# VK TECHNOLOGY E-COMMERCE PLATFORM - PRODUCTION ENV CONFIG
# Store: https://vktechnology.shop | Pedamiram, Andhra Pradesh
# ========================================================

# --------------------------------------------------------
# 1. Application Mode & Network
# --------------------------------------------------------
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.vktechnology.shop
API_BASE_URL=https://www.vktechnology.shop/api
CORS_ORIGINS=https://vktechnology.shop,https://www.vktechnology.shop,http://localhost:5173

# --------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas Primary + Hybrid Fallback)
# --------------------------------------------------------
# Replace with your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vktechnology?retryWrites=true&w=majority&appName=VKTechnologyCluster
MONGODB_URI=mongodb+srv://admin:YourSecurePassword@cluster0.mongodb.net/vktechnology?retryWrites=true&w=majority

# Optional: SQLite Local Persistence Path (used as hybrid offline fallback)
# SQLITE_DB_PATH=./data/vktechnology.db

# --------------------------------------------------------
# 3. Authentication & JWT Token Rotation Security
# --------------------------------------------------------
# Use high-entropy keys (minimum 32-64 characters)
JWT_SECRET=vk_technology_access_jwt_super_secret_production_key_2026_xyz
JWT_ACCESS_SECRET=vk_technology_access_jwt_super_secret_production_key_2026_xyz
JWT_REFRESH_SECRET=vk_technology_refresh_rotation_jwt_super_secret_key_2026_abc
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=vk_session_secure_cookie_random_secret_token_2026

# Super Admin Initial Identity
ADMIN_EMAIL=admin@vktechnology.shop
ADMIN_INITIAL_PASSWORD=Admin@VK2026!
OWNER_EMAIL=karthik.suroju@gmail.com
OWNER_PHONE=+918555997052

# --------------------------------------------------------
# 4. Razorpay Online Payment Gateway (India)
# --------------------------------------------------------
# Test mode: rzp_test_... / Live mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# --------------------------------------------------------
# 5. Transactional Communications (Email, SMS & WhatsApp)
# --------------------------------------------------------
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM="VK Technology <orders@vktechnology.shop>"

# SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@vktechnology.shop
SMTP_PASSWORD=your_app_specific_password

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_PHONE=+918555997052
OWNER_WHATSAPP_NUMBER=+918555997052

# --------------------------------------------------------
# 6. Persistent Cloud Asset Storage (Cloudinary / Amazon S3)
# --------------------------------------------------------
# Cloudinary format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OR Amazon S3:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=vktechnology-uploads
