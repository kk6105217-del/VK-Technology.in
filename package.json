{
  "name": "vk-technology",
  "version": "1.0.0",
  "description": "VK Technology - DIY Tech Projects E-Commerce Platform",
  "main": "server/dist/index.js",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client && node scripts/copy-dist.cjs",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "ecommerce",
    "electronics",
    "arduino",
    "esp32",
    "raspberry-pi",
    "robotics",
    "iot",
    "vk-technology"
  ],
  "author": "VK Technology",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "zod": "^4.6.7"
  }
}
